# Copy to `.env` in this folder (it is gitignored) and fill EVERY value in. Never commit the real file,
# never paste it into a chat or a ticket. See platform/docs/RUNBOOK.md for how to make each value.

# The public name of this deployment. It must resolve to this machine, and ports 80 and 443 must be open,
# so that the proxy can get a TLS certificate for it.
PUBLIC_DOMAIN=ask.example.com

# Where the browser reaches the app and where emailed links point. Use https and the same name as above.
ASK_WEB_ORIGINS=https://ask.example.com
ASK_WEB_BASE_URL=https://ask.example.com

# Database password. Use only letters and digits: it is placed inside a connection URL.
# Make one with:  python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# At least 32 random characters. Changing it later does not unpair lockets or sign anyone out: it voids
# pairing codes that have not been used yet, and each browser fetches a new CSRF token on its next page load.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ASK_SECRET_KEY=

# Email is required in production: invitations and password resets are sent by email.
ASK_EMAIL_FROM=ASK <no-reply@ask.example.com>
ASK_SMTP_HOST=
ASK_SMTP_PORT=587
ASK_SMTP_USERNAME=
ASK_SMTP_PASSWORD=
ASK_CONTACT_RECIPIENT=

# Processing. `none` means recordings wait in "queued" and the dashboard says so. `local` runs real
# models and needs a worker built with INSTALL_AI=true, downloaded weights and, for speaker separation,
# a Hugging Face token. `stub` is refused in production. Read platform/docs/AI.md first: the real-model
# path has not been verified.
ASK_AI_PROVIDER=none
ASK_HF_TOKEN=
# Which Whisper size transcribes (tiny.en, base.en, small, medium, large-v3). Bigger is more accurate and slower:
# measure on your hardware (python tools/benchmark_pipeline.py). Weights download on first start into the models volume.
ASK_AI_ASR_MODEL=small
ASK_AI_ASR_DEVICE=auto
ASK_AI_ASR_COMPUTE_TYPE=int8
# Who separates speakers: auto (pyannote if a token is set, otherwise nobody), pyannote, or clustering
# (EXPERIMENTAL, needs no token). See platform/docs/AI.md before choosing.
ASK_AI_DIARIZER=auto
# Voice signatures and the meeting summary (platform/docs/VOICE_SIGNATURE.md). Not calibrated on real people.
ASK_SIGNATURE_MATCH_THRESHOLD=0.5
ASK_SIGNATURE_MATCH_MARGIN=0.1
# auto, lexical or semantic. Sentence-model weights are never downloaded unless this is true.
ASK_ANALYSIS_ENGINE=auto
ASK_AI_TEXT_ALLOW_DOWNLOAD=false
# true: never contact the model hub; weights must already be in the models volume.
ASK_AI_OFFLINE=false
# Not calibrated until `python -m app.cli calibrate-speakers` has been run on your own recordings.
ASK_SPEAKER_MATCH_THRESHOLD=0.5
INSTALL_AI=false
