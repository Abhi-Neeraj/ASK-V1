# Copy to .env.local and adjust. Placeholders only: never commit real values.

# Where Next.js forwards /api/* requests (the FastAPI backend).
API_ORIGIN=http://127.0.0.1:8000

# Set to true only to review the UI with invented sample data and no backend.
# The dashboard shows a "Demo mode" banner whenever this is on. Leave false otherwise.
NEXT_PUBLIC_DEMO_MODE=false
