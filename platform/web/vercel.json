{
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ask-api-uaq9.onrender.com/api/:path*" },
    { "source": "/((?!_expo/|assets/|api/).*)", "destination": "/index.html" }
  ]
}
