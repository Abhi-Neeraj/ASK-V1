# Copy to `.env` (gitignored) or, for local development, run:
#   python -m app.cli generate-env
# Every value below is a placeholder. Real values never go in this file.

ASK_ENV=development

# Required. At least 32 random characters. Generate with `python -m app.cli generate-env`.
ASK_SECRET_KEY=
# At least 32 random characters, different from ASK_SECRET_KEY. Each locket's secret is derived from it and
# written into the locket at manufacture, so keep it for good: changing it breaks pairing for every locket.
ASK_LOCKET_MASTER_KEY=
# Pairing codes: minutes a request stays valid, and requests allowed per person per hour.
# ASK_LOCKET_CODE_TTL_MINUTES=10
# ASK_LOCKET_CODE_REQUESTS_PER_HOUR=5
# ASK_LOCKET_CODE_REQUESTS_PER_LOCKET_PER_HOUR=10
# Firmware updates: minutes a download link works, and the largest file accepted (bytes).
# ASK_FIRMWARE_LINK_MINUTES=30
# ASK_FIRMWARE_MAX_BYTES=4194304
# The one company (its UUID) whose administrators may publish firmware: the operator, never a customer.
# ASK_FIRMWARE_PUBLISHER_COMPANY_ID=

# Database. Development defaults to a local SQLite file; production must use PostgreSQL:
#   ASK_DATABASE_URL=postgresql+psycopg://user:password@host:5432/ask
# ASK_DATABASE_URL=

# Where uploaded audio is kept (default: platform/data/recordings).
# ASK_STORAGE_DIR=

# Browser origins allowed to call the API (comma separated, never "*").
ASK_WEB_ORIGINS=http://localhost:3000
ASK_WEB_BASE_URL=http://localhost:3000

# Behind the web app's /api proxy the client address arrives in X-Forwarded-For.
# Enable only when a proxy you control sits in front of the API.
ASK_TRUST_FORWARDED_FOR=true
# How many proxies you control in front of the API (the client address is counted from the end).
# ASK_TRUSTED_PROXY_HOPS=1

# Email: console prints messages to the log (development only); production needs smtp.
ASK_EMAIL_BACKEND=console
# ASK_EMAIL_FROM=
# ASK_SMTP_HOST=
# ASK_SMTP_PORT=587
# ASK_SMTP_USERNAME=
# ASK_SMTP_PASSWORD=
# ASK_CONTACT_RECIPIENT=

# Periodic upkeep inside the API process. Set to false to run
# `python -m app.cli housekeeping` from a scheduler instead.
# ASK_RUN_BACKGROUND_TASKS=true

# Processing worker (`python -m app.worker`). See docs/AI.md.
#   none  : no worker may start; recordings wait in "queued" (default)
#   stub  : development only; writes labelled PLACEHOLDER text, names nobody. Refused in production.
#   local : real models. Needs `pip install -e ".[ai]"`, downloaded weights, and for speaker
#           separation a Hugging Face token (below). Not verified where this was written.
# ASK_AI_PROVIDER=none
# google: Google Cloud Speech-to-Text writes the transcript, Gemini writes the summary. Needs
# `pip install -e ".[google]"`, a service-account JSON file and a Gemini API key. Audio leaves this server.
# ASK_GOOGLE_APPLICATION_CREDENTIALS=
# ASK_GOOGLE_STT_LANGUAGE=en-US
# ASK_GEMINI_API_KEY=
# ASK_GEMINI_MODEL=gemini-2.5-flash
# ASK_HF_TOKEN=
# Model settings (all optional; defaults shown). Weights are downloaded on first use unless ASK_AI_OFFLINE=true.
# ASK_AI_ASR_MODEL=small            # tiny, base, small, medium, large-v3 ... or a path to converted weights
# ASK_AI_ASR_DEVICE=auto            # auto, cpu or cuda
# ASK_AI_ASR_COMPUTE_TYPE=int8      # int8 for CPU; float16 for a GPU
# ASK_AI_ASR_BEAM_SIZE=5            # 1 is fastest
# ASK_AI_ASR_LANGUAGE=              # a code such as en; empty detects it for each recording
# ASK_AI_TORCH_DEVICE=auto          # where speaker separation and matching run: auto, cpu or cuda
# ASK_AI_CPU_THREADS=0              # 0 lets each library choose
# ASK_AI_MODEL_DIR=                 # where weights are kept (default: the libraries' own caches)
# ASK_AI_OFFLINE=false              # true: never contact the model hub; fail if weights are missing
# Who separates speakers: auto (pyannote if installed AND ASK_HF_TOKEN is set, otherwise nobody), pyannote, or
# clustering (EXPERIMENTAL; needs no token; the dashboard says to check its labels by listening).
# ASK_AI_DIARIZER=auto
# pitch is EXPERIMENTAL too and needs no token and no model: it tells voices apart by pitch first and voice colour
# second (ASK_AI_DIARIZER=pitch). See platform/docs/VOICE_SIGNATURE.md.
# ASK_DIARIZATION_PITCH_GATE_OCTAVES=0.45
# ASK_DIARIZATION_PITCH_CLUSTER_DISTANCE=1.2
# Voice signatures (pitch plus voice colour). NOT calibrated on real people.
# ASK_SIGNATURE_MATCH_THRESHOLD=0.5
# ASK_SIGNATURE_MATCH_MARGIN=0.1
# ASK_SIGNATURE_PITCH_GATE_OCTAVES=0.4
# The meeting summary: auto, lexical or semantic. Weights for the sentence model are never downloaded unless
# ASK_AI_TEXT_ALLOW_DOWNLOAD=true (see platform/docs/VOICE_SIGNATURE.md).
# ASK_ANALYSIS_ENGINE=auto
# ASK_AI_TEXT_ALLOW_DOWNLOAD=false
# Context check: a sentence stays in the context of the closest of the three before it if more similar than this.
# Empty: 0.30 for the sentence model (measured; 0.6 called almost everything a new topic), none for the words engine.
# ASK_CONTEXT_SIMILARITY=
# A worker that dies mid-recording is replaced after this many seconds.
# ASK_JOB_LOCK_TIMEOUT_SECONDS=180
# The matching threshold is NOT calibrated until you run `python -m app.cli calibrate-speakers`.
# ASK_SPEAKER_MATCH_THRESHOLD=0.5
# Alternative to the service-account file: a Google Cloud API key with Speech-to-Text enabled.
# ASK_GOOGLE_STT_API_KEY=
