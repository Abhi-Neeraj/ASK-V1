# Railway copy of Dockerfile: same image, but the start command runs migrations first.
# ASK platform API and processing worker. One image, two commands (see platform/deploy/docker-compose.yml).
#
# NOT BUILT OR RUN where this was written: there was no Docker on that machine. Build it, run
# `docker compose config`, and follow platform/docs/RUNBOOK.md before trusting it.
#
#   docker build -t ask-api platform/api                      # API and migrations, no AI libraries
#   docker build --build-arg INSTALL_AI=true -t ask-worker platform/api   # worker with real models (large)

FROM python:3.11-slim AS runtime

ARG INSTALL_AI=false
# CPU-only wheels for torch (the default Linux wheel bundles CUDA libraries and adds gigabytes). For a GPU
# server, build with --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu128 (or your CUDA version).
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# The application runs from this folder rather than being installed, so only the dependencies
# are installed here (the pinned ones in pyproject.toml, plus the PostgreSQL driver).
COPY pyproject.toml ./
RUN pip install ".[postgres,google]" \
    && if [ "$INSTALL_AI" = "true" ]; then \
         apt-get update \
         && apt-get install -y --no-install-recommends libsndfile1 \
         && rm -rf /var/lib/apt/lists/* \
         && pip install --index-url "$TORCH_INDEX" "torch==2.14.1" "torchaudio==2.11.0" \
         && pip install ".[ai]"; \
       fi

COPY alembic.ini ./
COPY migrations ./migrations
COPY app ./app

# Never run as root. Recordings and model weights live on volumes mounted under /data and /models.
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin ask \
    && mkdir -p /data/recordings /models \
    && chown -R ask:ask /data /models /app
USER ask

ENV ASK_ENV=production \
    ASK_STORAGE_DIR=/data/recordings \
    ASK_AI_MODEL_DIR=/models \
    HF_HOME=/models/huggingface

# Let a database that bills by the hour (the free Neon plan) go to sleep when nobody is using ASK: the worker stops
# asking it for work after 10 idle minutes and is woken by a file the API touches when a recording arrives, and the
# API's own upkeep runs hourly instead of every 15 seconds. Harmless on any other database. Override in the host's
# settings; see app/services/wake.py.
ENV ASK_WORKER_WAKE_FILE=/tmp/ask-worker-wake \
    ASK_WORKER_SLEEPY_AFTER_SECONDS=600 \
    ASK_BACKGROUND_INTERVAL_SECONDS=3600

# Keep a compressed copy of each recording's audio in the database (up to 700 MB), so "Play audio" still works
# after this host restarts and its disk is empty again. See app/services/audio_archive.py.
ENV ASK_AUDIO_ARCHIVE_MAX_BYTES=700000000

EXPOSE 8000

# `--factory` is required: nothing is built at import time. The short graceful timeout keeps open
# live-update streams from holding up a restart. `--no-access-log` because an invitation link carries its secret
# in the URL path, and the access log would keep every one of them (the application logs what it needs itself).
# Railway: the processing worker runs beside the API in this one container, because uploaded audio lives on this
# container's disk (the /data volume) and a separate service could not read it. It restarts itself if it stops.
# Render: `bootstrap-from-env` creates the first company from ASK_BOOTSTRAP_* while none exists (no console there);
# without those settings (Railway) it does nothing.
CMD ["sh", "-c", "python -m alembic -c alembic.ini upgrade head 2>&1 | tail -1; python -m app.cli bootstrap-from-env; (while true; do python -m app.worker; sleep 5; done) & exec python -m uvicorn app.main:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --timeout-graceful-shutdown 3 --no-access-log"]
