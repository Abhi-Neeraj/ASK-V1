# ASK environment template (safe to commit: placeholders only).
# Copy these lines into the project-root `.env` file and fill in your own values.
# Expo loads `.env` from the project root only, not from this folder.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
