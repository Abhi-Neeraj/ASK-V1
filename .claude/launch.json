{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "platform-api",
      "runtimeExecutable": "platform/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:create_app", "--factory", "--app-dir", "platform/api", "--port", "8000", "--timeout-graceful-shutdown", "3"],
      "port": 8000
    },
    {
      "name": "platform-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "platform/web", "--", "--port", "3000", "-H", "127.0.0.1"],
      "port": 3000
    },
    {
      "name": "platform-web-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo", "--prefix", "platform/web", "--", "--port", "3000", "-H", "127.0.0.1"],
      "port": 3000
    }
  ]
}
